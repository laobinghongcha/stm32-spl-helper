      "id": "HAL_FLASH_Program",
      "name": "HAL_FLASH_Program",
      "peripheral": "FLASH",
      "library": "hal",
      "sectionId": "FLASH@hal#sec1",
      "prototype": "HAL_StatusTypeDef HAL_FLASH_Program(uint32_t TypeProgram, uint32_t Address, uint64_t Data);",
      "returnType": "HAL_StatusTypeDef",
      "params": [
        {
          "name": "TypeProgram",
          "type": "uint32_t",
          "descEn": "Indicate the way to program at a specified address. This parameter can be a value of @ref FLASH_Type_Program",
          "descZh": "编程宽度：FLASH_TYPEPROGRAM_HALFWORD（16 位）或 FLASH_TYPEPROGRAM_WORD（32 位）。F1 不支持按字节编程。"
        },
        {
          "name": "Address",
          "type": "uint32_t",
          "descEn": "Specifies the address to be programmed.",
          "descZh": "目标地址。必须按编程宽度对齐（半字 2 字节、字 4 字节），且该位置已擦除为 0xFFFF。"
        },
        {
          "name": "Data",
          "type": "uint64_t",
          "descEn": "Specifies the data to be programmed",
          "descZh": "要写入的数据，宽度要与 TypeProgram 一致。"
        }
      ],
      "returnDescEn": "HAL_StatusTypeDef HAL Status",
      "returnDescZh": "",
      "briefEn": "Program halfword, word or double word at a specified address",
      "briefZh": "按指定的编程宽度向目标地址写入数据。目标地址必须是已擦除状态（0xFFFF）。",
      "usageZh": "",
      "prerequisites": [],
      "registers": [],
      "relatedFunctions": [],
      "remarks": [
        "The function HAL_FLASH_Unlock() should be called before to unlock the FLASH interface The function HAL_FLASH_Lock() should be called after to lock the FLASH interface",
        "If an erase and a program operations are requested simultaneously, the erase operation is performed before the program one.",
        "FLASH should be previously erased before new programmation (only exception to this is when 0x0000 is programmed)"
      ],
      "notesZh": [],
      "exampleCode": "/* 写入前必须确保该地址已擦除（0xFFFF） */\nHAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD,   /* 32 位编程 */\n                  0x0801F000,\n                  0x12345678);",
      "exampleLanguage": "c",

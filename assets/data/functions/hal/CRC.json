      "prototype": "uint32_t HAL_CRC_Calculate(CRC_HandleTypeDef *hcrc, uint32_t pBuffer[], uint32_t BufferLength);",
      "returnType": "uint32_t",
      "params": [
        {
          "name": "hcrc",
          "type": "CRC_HandleTypeDef *",
          "descEn": "CRC handle",
          "descZh": "CRC 句柄。"
        },
        {
          "name": "pBuffer",
          "type": "uint32_t []",
          "descEn": "pointer to the input data buffer.",
          "descZh": "数据缓冲区首地址。"
        },
        {
          "name": "BufferLength",
          "type": "uint32_t",
          "descEn": "input data buffer length (number of uint32_t words).",
          "descZh": "数据长度（单位是 32 位字，不是字节）。传字节数会算错。"
        }
      ],
      "returnDescEn": "uint32_t CRC (returned value LSBs for CRC shorter than 32 bits)",
      "returnDescZh": "",
      "briefEn": "Compute the 32-bit CRC value of a 32-bit data buffer starting with hcrc->Instance->INIT as initialization value.",
      "briefZh": "对指定缓冲区重新开始计算 CRC（先复位再算），返回 32 位结果。",
      "usageZh": "算一帧数据的校验和时用它。内部先把 CRC_DR 复位成 0xFFFFFFFF，所以每次调用都是**独立**的一次计算。要在一段已有结果上接着算（分包校验），用 HAL_CRC_Accumulate。",
      "prerequisites": [],
      "registers": [],
      "relatedFunctions": [],
      "remarks": [],
      "notesZh": [
        "BufferLength 单位是 uint32_t 个数：字节数组要写成 (len + 3) / 4 并把缓冲区按 4 字节对齐",
        "缓冲区地址必须 4 字节对齐，否则在 Cortex-M3 上可能触发 HardFault（UNALIGNED 位没开时）"
      ],

    {
      "id": "HAL_PWR_EnterSTOPMode",
      "name": "HAL_PWR_EnterSTOPMode",
      "peripheral": "PWR",
      "library": "hal",
      "sectionId": "PWR@hal#sec2",
      "prototype": "void HAL_PWR_EnterSTOPMode(uint32_t Regulator, uint8_t STOPEntry);",
      "returnType": "void",
      "params": [
        {
          "name": "Regulator",
          "type": "uint32_t",
          "descEn": "Specifies the regulator state in Stop mode. This parameter can be one of the following values:",
          "descZh": "调压器状态：PWR_MAINREGULATOR_ON（主调压器，唤醒快）或 PWR_LOWPOWERREGULATOR_ON（低功耗，更省电）。"
        },
        {
          "name": "STOPEntry",
          "type": "uint8_t",
          "descEn": "Specifies if Stop mode in entered with WFI or WFE instruction. This parameter can be one of the following values:",
          "descZh": "进入停止的方式：PWR_STOPENTRY_WFI 或 WFE。"
        }
      ],
      "returnDescEn": "None",
      "returnDescZh": "",
      "briefEn": "Enters Stop mode.",
      "briefZh": "进入停止模式：所有时钟停止但 SRAM 保留，唤醒后需重新配置系统时钟。",
      "usageZh": "",
      "prerequisites": [],
      "registers": [],
      "relatedFunctions": [],
      "remarks": [
        "In Stop mode, all I/O pins keep the same state as in Run mode.",
        "When exiting Stop mode by using an interrupt or a wakeup event, HSI RC oscillator is selected as system clock.",
        "When the voltage regulator operates in low power mode, an additional startup delay is incurred when waking up from Stop mode. By keeping the internal regulator ON during Stop mode, the consumption is higher although the startup time is reduced."
      ],
      "notesZh": [],
      "exampleCode": "/* 进入 STOP 模式，等中断唤醒 */\nHAL_PWR_EnterSTOPMode(PWR_LOWPOWERREGULATOR_ON, PWR_STOPENTRY_WFI);\n\n/* 唤醒后时钟退回 HSI，必须重配时钟树！ */\nSystemClock_Config();",
      "exampleLanguage": "c",
      "symbolRefs": [
        "IS_PWR_REGULATOR",
        "IS_PWR_STOP_ENTRY",
        "PWR_STOPENTRY_WFI"
      ],
      "headerLine": 351,
      "definedIn": "stm32f1xx_hal_pwr.h",

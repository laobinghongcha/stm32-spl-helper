      "library": "hal",
      "sectionId": "PWR@hal#sec2",
      "prototype": "void HAL_PWR_EnterSLEEPMode(uint32_t Regulator, uint8_t SLEEPEntry);",
      "returnType": "void",
      "params": [
        {
          "name": "Regulator",
          "type": "uint32_t",
          "descEn": "Regulator state as no effect in SLEEP mode - allows to support portability from legacy software",
          "descZh": "调压器状态：PWR_MAINREGULATOR_ON（主调压器，唤醒快）或 PWR_LOWPOWERREGULATOR_ON（低功耗，更省电）。"
        },
        {
          "name": "SLEEPEntry",
          "type": "uint8_t",
          "descEn": "Specifies if SLEEP mode is entered with WFI or WFE instruction. When WFI entry is used, tick interrupt have to be disabled if not desired as the interrupt wake up source. This parameter can be one of the following values:",
          "descZh": "进入睡眠的方式：PWR_SLEEPENTRY_WFI（等中断）或 WFE（等事件）。"
        }
      ],
      "returnDescEn": "None",
      "returnDescZh": "",
      "briefEn": "Enters Sleep mode.",
      "briefZh": "进入睡眠模式：只关 CPU 时钟，外设仍在运行，任意中断可唤醒。",
      "usageZh": "",
      "prerequisites": [],
      "registers": [],
      "relatedFunctions": [],
      "remarks": [
        "In Sleep mode, all I/O pins keep the same state as in Run mode."
      ],
      "notesZh": [],
      "exampleCode": "/* 睡眠：只停 CPU 时钟，任意中断可唤醒 */\nHAL_PWR_EnterSLEEPMode(PWR_MAINREGULATOR_ON, PWR_SLEEPENTRY_WFI);",

    {
      "id": "LL_WWDG_SetCounter",
      "name": "LL_WWDG_SetCounter",
      "peripheral": "WWDG",
      "library": "ll",
      "sectionId": "WWDG@ll#sec1",
      "prototype": "void LL_WWDG_SetCounter(WWDG_TypeDef * WWDGx, uint32_t Counter);",
      "returnType": "void",
      "params": [
        {
          "name": "WWDGx",
          "type": "WWDG_TypeDef *",
          "descEn": "WWDG Instance",
          "descZh": "窗口看门狗实例指针（F1 上固定是 WWDG）。"
        },
        {
          "name": "Counter",
          "type": "uint32_t",
          "descEn": "0..0x7F (7 bit counter value)",
          "descZh": "计数器数值（CNT）。"
        }
      ],
      "returnDescEn": "None",
      "returnDescZh": "",
      "briefEn": "Set the Watchdog counter value to provided value (7-bits T[6:0])",
      "briefZh": "设置窗口看门狗的计数值（同时就是喂狗动作）。太早或太晚喂都会复位。",
      "usageZh": "",
      "prerequisites": [],
      "registers": [
        "WWDGx_CR"
      ],
      "relatedFunctions": [],
      "remarks": [
        "When writing to the WWDG_CR register, always write 1 in the MSB b6 to avoid generating an immediate reset This counter is decremented every (4096 x 2expWDGTB) PCLK cycles A reset is produced when it rolls over from 0x40 to 0x3F (bit T6 becomes cleared) Setting the counter lower then 0x40 causes an immediate reset (if WWDG enabled)"
      ],
      "notesZh": [],
      "exampleCode": "",
      "exampleLanguage": "c",
      "symbolRefs": [],
      "headerLine": 150,
      "definedIn": "stm32f1xx_ll_wwdg.h",

      "id": "LL_WWDG_Enable",
      "name": "LL_WWDG_Enable",
      "peripheral": "WWDG",
      "library": "ll",
      "sectionId": "WWDG@ll#sec1",
      "prototype": "void LL_WWDG_Enable(WWDG_TypeDef * WWDGx);",
      "returnType": "void",
      "params": [
        {
          "name": "WWDGx",
          "type": "WWDG_TypeDef *",
          "descEn": "WWDG Instance",
          "descZh": "窗口看门狗实例指针（F1 上固定是 WWDG）。"
        }
      ],
      "returnDescEn": "None",
      "returnDescZh": "",
      "briefEn": "Enable Window Watchdog. The watchdog is always disabled after a reset.",
      "briefZh": "使能窗口看门狗并开始计数。",
      "usageZh": "",
      "prerequisites": [],
      "registers": [
        "WWDGx_CR"
      ],
      "relatedFunctions": [],
      "remarks": [
        "It is enabled by setting the WDGA bit in the WWDG_CR register, then it cannot be disabled again except by a reset. This bit is set by software and only cleared by hardware after a reset. When WDGA = 1, the watchdog can generate a reset."
      ],
      "notesZh": [],
